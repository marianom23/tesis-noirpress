# Sólo se publica el material seleccionado para el respaldo.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/requirements-respaldo.txt
!/Ordenes_Noirpress_limpio.xlsx
!/scripts/
!/fuentes/
!/resultados_noirpress/
/fuentes/*
!/fuentes/*.xlsx
!/fuentes/LEEME.md
/resultados_noirpress/*
!/resultados_noirpress/cierre/
!/resultados_noirpress/evaluacion_final/
__pycache__/
*.pyc
.env
.env.*
.venv/
venv/
*.log
~$*
